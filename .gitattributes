# 设置默认行为：所有文本文件默认使用LF
* text=auto eol=lf

# 明确声明应该规范化的文本文件（所有这些都会使用LF）
*.c text
*.cpp text
*.h text
*.hpp text
*.java text
*.js text
*.ts text
*.json text
*.htm text
*.html text
*.xml text
*.txt text
*.ini text
*.md text
*.yml text
*.yaml text
*.sql text
*.css text
*.scss text
*.less text
*.sass text
*.py text
*.rb text
*.php text
*.go text
*.rs text

# 确保Shell脚本使用LF
*.sh text eol=lf
*.bash text eol=lf

# 确保批处理脚本使用CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件 - 不进行任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
*.war binary
*.ear binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
