#!/usr/bin/env bash
set -euo pipefail

# Lightweight smoke checklist for self-hosted enterprise mode.
# This script does not replace full e2e tests; it verifies that the expected
# environment variables are present and gives operators a deterministic manual
# checklist for app-level validation.

: "${SELF_HOSTED_ENTERPRISE:=true}"
: "${SKIP_USAGE_VERIFICATION:=false}"
: "${SKIP_API_USAGE_VERIFICATION:=false}"
: "${API_MAX_MODIFY_RECORD_COUNTS:=9007199254740991}"
: "${SERVER_MAX_RECORD_COUNT:=9007199254740991}"
: "${TEMPLATE_MAX_COUNT:=2147483647}"
: "${SPACE_MAX_COUNT:=2147483647}"

if [[ "${SELF_HOSTED_ENTERPRISE}" != "true" ]]; then
  echo "ERROR: SELF_HOSTED_ENTERPRISE must be true for this smoke check." >&2
  exit 1
fi

if [[ "${SKIP_USAGE_VERIFICATION}" == "true" ]]; then
  echo "ERROR: SKIP_USAGE_VERIFICATION=true prevents backend space usage statistics from being calculated." >&2
  exit 1
fi

if [[ "${SKIP_API_USAGE_VERIFICATION}" == "true" ]]; then
  echo "ERROR: SKIP_API_USAGE_VERIFICATION=true makes backend API usage statistics report zero." >&2
  exit 1
fi

if ! [[ "${API_MAX_MODIFY_RECORD_COUNTS}" =~ ^[0-9]+$ ]]; then
  echo "ERROR: API_MAX_MODIFY_RECORD_COUNTS must be a positive integer." >&2
  exit 1
fi

if [[ "${API_MAX_MODIFY_RECORD_COUNTS}" -lt 1000 ]]; then
  echo "ERROR: API_MAX_MODIFY_RECORD_COUNTS is too low for enhanced self-hosted mode." >&2
  exit 1
fi

for limit_name in SERVER_MAX_RECORD_COUNT TEMPLATE_MAX_COUNT SPACE_MAX_COUNT; do
  limit_value="${!limit_name}"
  if ! [[ "${limit_value}" =~ ^[0-9]+$ ]]; then
    echo "ERROR: ${limit_name} must be a positive integer." >&2
    exit 1
  fi
  if [[ "${limit_value}" -lt 1000000 ]]; then
    echo "ERROR: ${limit_name} is too low for self-hosted enterprise mode." >&2
    exit 1
  fi
done

cat <<'EOF'
Self-hosted enterprise env looks OK.

Manual smoke checklist:

1. Start backend-server, room-server, and frontend/datasheet. This build defaults to:
  SELF_HOSTED_ENTERPRISE=true
  SKIP_USAGE_VERIFICATION=false
  SKIP_API_USAGE_VERIFICATION=false
  API_MAX_MODIFY_RECORD_COUNTS=9007199254740991
  SERVER_MAX_RECORD_COUNT=9007199254740991
  TEMPLATE_MAX_COUNT=2147483647
  SPACE_MAX_COUNT=2147483647

2. Register or log in.
3. Create a new space.
4. Open space subscription/management info and verify plan/product is Enterprise/enterprise.
5. Verify the space overview current usage cards show real member/file/record/capacity values, not all zero.
6. Create a datasheet.
7. Add more records than the old free single-sheet limit.
8. Add enough records to exceed the old free space total-row limit.
9. Create multiple Gantt/Calendar/Gallery/Kanban/Form views if those UI entries are enabled.
10. Upload an attachment using the configured storage backend.
11. Call Fusion API batch write beyond the old free/default batch limits.
12. Confirm there is no payment reminder, PRICE_MODAL, renew/upgrade modal, or usage warning modal.
13. Confirm enterprise/hosted-only entry points remain visible, and unavailable integrations return a clear unsupported or unconfigured response.

Automated checks that can be run against a running container:

  # The database schema is applied by the init-db image, which is built from
  # this repository, so the changelog has to be at the current version.
  docker exec apitable mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -e \
    "select ID from apitable.apitable_db_changelog order by ORDEREXECUTED desc limit 1;" apitable

  # The template space and the seeded data come from the init-appdata image,
  # which is mirrored from upstream. Upstream apitable/init-appdata is still on
  # the 1.8.0 release line while this repository is on 1.13.0, so the seeded
  # content has to be verified explicitly.
  #
  # Note: since 1.13 the space concept lives in the node table, the legacy
  # apitable_space table stays empty. Records are linked to a datasheet through
  # dst_id, not through a datasheet_id column.
  docker exec apitable mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -e \
    "select count(*) from apitable.apitable_node where space_id='spcNTxlv8Drra';" apitable
  docker exec apitable mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -e \
    "select count(*) from apitable.apitable_datasheet where space_id='spcNTxlv8Drra';" apitable
  docker exec apitable mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -e \
    "select count(*) from apitable.apitable_datasheet_record r \
       join apitable.apitable_datasheet d on r.dst_id = d.dst_id \
       where d.space_id='spcNTxlv8Drra';" apitable
  docker exec apitable mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -e \
    "select count(*) from apitable.apitable_user;" apitable

  # The backend has to be able to serve the seeded template space.
  curl -sf http://localhost/api/v1/client/info | head -c 200

Expected on a healthy deployment: the changelog is at the 1.13 changeset, the
template space has 65 nodes and 33 datasheets with 298 records, one initial
user exists, and client/info answers with 200.

If the template space is missing or empty, the mirrored init-appdata image is
incompatible with the current schema. Either mirror a newer init-appdata build
or build one from the matching upstream source.

If any feature depends on missing private enterprise code, hosted cloud services,
missing DB tables, or missing third-party configuration, keep the user-facing entry point intact and return a clear unsupported/unconfigured response.
EOF
