{
  "extends": "nx/presets/npm.json",
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "build-cjs"
        ],
        "runtimeCacheInputs": [
          "echo $SEMVER_FULL",
          "echo $NEXT_ASSET_PREFIX",
          "echo $NEXT_PUBLIC_ASSET_PREFIX"
        ]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/web_build"
      ]
    },
    "build-cjs": {
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
