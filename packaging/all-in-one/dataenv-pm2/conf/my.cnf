#
# The MySQL  Server configuration file.
#
# For explanations see
# http://dev.mysql.com/doc/mysql/en/server-system-variables.html

[mysqld]
pid-file        = /var/run/mysqld/mysqld.pid
socket          = /var/run/mysqld/mysqld.sock
datadir         = /apitable/mysql
secure-file-priv= NULL

# MySQL 8 refuses to start when this differs from the value used at
# initialization ("Different lower_case_table_names settings for server ('2')
# and data dictionary ('0')"). The cluster used to pass --lower_case_table_names=2
# on the command line, but on a case-sensitive Linux filesystem --initialize
# silently falls back to 0, so every container restart aborted. Keep 0 here so
# initialization and every later start agree.
lower_case_table_names = 0

# The stock 128M buffer pool makes large datasheet reads hit the disk. 512M is a
# reasonable default for the single-container deployment; raise it when the host
# has more memory to spare.
innodb_buffer_pool_size = 512M
# MySQL 8.0.30+ replaced innodb_log_file_size with innodb_redo_log_capacity.
innodb_redo_log_capacity = 512M

# NOTE: do not set innodb_flush_method=O_DIRECT here. The data directory is a
# bind mount, and O_DIRECT is not supported on every host filesystem (Docker
# Desktop on macOS/Windows for example), where mysqld then refuses to start.

skip-host-cache
skip-name-resolve

[client]
socket=/var/run/mysqld/mysqld.sock

# Custom config should go here
!includedir /etc/mysql/conf.d/
