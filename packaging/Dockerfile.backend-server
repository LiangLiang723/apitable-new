FROM amazoncorretto:17-al2023 AS builder

RUN dnf install -y findutils \
    && dnf clean all \
    && rm -rf /var/cache/dnf

WORKDIR /app

# The wrapper and its build logic are stable across source changes, so they are
# copied before the sources: warming the wrapper distribution stays cached when
# only application code changes.
COPY backend-server/gradlew backend-server/gradlew.bat \
     backend-server/settings.gradle backend-server/build.gradle \
     backend-server/gradle.properties ./
COPY backend-server/gradle ./gradle
COPY backend-server/buildSrc ./buildSrc

# The jar manifest records this timestamp instead of the wall clock, so the same
# commit produces the same jar. Local builds fall back to the epoch.
ARG SOURCE_DATE_EPOCH=0

# Gradle caches are mounted instead of baked into the layer: the dependency
# graph is resolved once and reused by every later build, while the produced
# image only keeps the jar. ./gradlew -v warms the wrapper distribution.
RUN --mount=type=cache,target=/root/.gradle ./gradlew -v

COPY backend-server/ ./

RUN --mount=type=cache,target=/root/.gradle \
    --mount=type=cache,target=/app/.gradle \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    ./gradlew --no-daemon -Dorg.gradle.vfs.watch=false :application:bootJar

# Split the fat jar into Spring Boot layers. The runtime image then copies the
# dependency layers (which only change when a dependency changes) separately from
# the application layer, so a code-only release pushes a few MB instead of 183MB.
RUN set -eux; \
    java -Djarmode=layertools \
         -jar /app/application/build/libs/application.jar \
         extract --destination /app/layers; \
    mkdir -p /app/layers/dependencies /app/layers/spring-boot-loader \
             /app/layers/snapshot-dependencies /app/layers/application


# Runtime image only needs a JRE: the headless variant drops the GUI stack while
# keeping everything the service uses (including the PDF export path).
FROM amazoncorretto:17-al2023-headless

ARG SEMVER_FULL
ENV SEMVER_FULL=${SEMVER_FULL}

WORKDIR /app

# Layer order matters: the more frequently a layer changes, the later it is
# copied, so Docker can reuse the caches above it.
COPY --from=builder /app/layers/dependencies/ ./
COPY --from=builder /app/layers/spring-boot-loader/ ./
COPY --from=builder /app/layers/snapshot-dependencies/ ./
COPY --from=builder /app/layers/application/ ./

EXPOSE 8081
# The launcher is the one declared in META-INF/MANIFEST.MF of the built jar
# (org.springframework.boot.loader.launch.JarLauncher on Spring Boot 3.2); it also
# works for the exploded layer layout used here.
# -Xss512k: Tomcat runs up to 200 request threads, the default 1MB stack each is
#           a lot of reserved address space for a service that barely recurses.
# -XX:MaxRAMPercentage=50: container aware heap sizing; without a cgroup limit
#           the JVM still falls back to 50% of the host memory.
ENTRYPOINT ["java", \
    "-XX:MaxRAMPercentage=50", \
    "-XX:MaxMetaspaceSize=256m", \
    "-XX:ReservedCodeCacheSize=128m", \
    "-Xss512k", \
    "-XX:+ExitOnOutOfMemoryError", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "--add-opens=java.base/java.lang=ALL-UNNAMED", \
    "org.springframework.boot.loader.launch.JarLauncher"]
