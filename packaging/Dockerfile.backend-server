FROM amazoncorretto:17-al2023 AS builder

RUN dnf install -y findutils \
    && dnf clean all \
    && rm -rf /var/cache/dnf

WORKDIR /app
COPY ./backend-server/. .

# Gradle caches are mounted instead of baked into the layer: the dependency
# graph is resolved once and reused by every later build, while the produced
# image only keeps the jar. ./gradlew -v warms the wrapper distribution.
RUN --mount=type=cache,target=/root/.gradle ./gradlew -v
RUN --mount=type=cache,target=/root/.gradle \
    --mount=type=cache,target=/app/.gradle \
    ./gradlew --no-daemon -Dorg.gradle.vfs.watch=false :application:bootJar


# Runtime image only needs a JRE: the headless variant drops the GUI stack while
# keeping everything the service uses (including the PDF export path).
FROM amazoncorretto:17-al2023-headless

ARG SEMVER_FULL
ENV SEMVER_FULL=${SEMVER_FULL}

WORKDIR /app

COPY --from=builder /app/application/build/libs/*.jar /app/app.jar

EXPOSE 8081
# -Xss512k: Tomcat runs up to 200 request threads, the default 1MB stack each is
#           a lot of reserved address space for a service that barely recurses.
# -XX:MaxRAMPercentage=50: container aware heap sizing; without a cgroup limit
#           the JVM still falls back to 50% of the host memory.
ENTRYPOINT ["java", \
    "-XX:MaxRAMPercentage=50", \
    "-XX:MaxMetaspaceSize=256m", \
    "-XX:ReservedCodeCacheSize=128m", \
    "-Xss512k", \
    "-XX:+ExitOnOutOfMemoryError", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "--add-opens=java.base/java.lang=ALL-UNNAMED", \
    "-jar", "/app/app.jar"]
