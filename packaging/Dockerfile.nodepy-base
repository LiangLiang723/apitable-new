# Base image for the web-server (datasheet) build.
#
# Alpine variant of Dockerfile.node-base: Node 22.22.2 plus build-base and
# python3 for node-gyp, so dependencies without a prebuilt binary can still be
# compiled. py3-setuptools is required because node-gyp still imports the
# `distutils` module, which Python 3.12 no longer ships in the standard library.
#
# This image used to be a mirror of `apitable/nodepy`. It is now built from the
# official Node image, so the build chain no longer pulls from the upstream
# namespace.
#
# The tag is part of the component fingerprint in the release workflow: when the
# content of this file changes, bump NODEPY_BASE_TAG (for example to
# 22.22.2-alpine-r1) and the fingerprint will mark web-server as changed.
FROM node:22.22.2-alpine

RUN apk add --no-cache \
        build-base \
        git \
        pkgconfig \
        python3 \
        py3-setuptools

RUN npm install -g pnpm@8.13.1 \
    && node --version \
    && pnpm --version
