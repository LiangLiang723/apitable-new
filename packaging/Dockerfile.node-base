# Base image for the room-server build.
#
# It provides Node 22.22.2 on Debian bookworm plus the native toolchain
# (build-essential, pkg-config, python3 for node-gyp) so that any dependency
# without a prebuilt binary can still be compiled. The component Dockerfiles
# call `pnpm install` directly, so pnpm is installed here as well.
#
# Node 16 is end of life, and its last base image (Debian bullseye) is only
# available through the Debian archive. This image moved to a supported
# combination: Node 22 on bookworm.
#
# This image used to be a mirror of `apitable/node`, which made the build chain
# depend on the upstream namespace. It is now built from the official Node image
# instead.
#
# The tag is part of the component fingerprint in the release workflow: when the
# content of this file changes, bump NODE_BASE_TAG (for example to v22.22.2-r1)
# and the fingerprint will mark room-server as changed.
FROM node:22.22.2-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        pkg-config \
        python3; \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@8.13.1 \
    && node --version \
    && pnpm --version
